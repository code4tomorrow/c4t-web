# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
# Step-by-step instructions for every value are in SETUP.md.

# ---------------------------------------------------------------- REQUIRED --

# Postgres connection string (Neon free tier — see SETUP.md step 1).
# Must include ?sslmode=require for Neon.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# The full public URL of this site. Locally this is http://localhost:3000.
# In production it must match your real domain exactly (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"

# Random secret used to sign session cookies.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=""

# ------------------------------------------------- SIGN-IN (pick at least 1) --

# GitHub OAuth (SETUP.md step 3).
# Callback URL to register with GitHub:
#   http://localhost:3000/api/auth/callback/github        (local)
#   https://YOUR-DOMAIN/api/auth/callback/github          (production)
GITHUB_ID=""
GITHUB_SECRET=""

# Email magic links (SETUP.md step 4). Resend's free tier works well.
# If you leave these blank, only GitHub sign-in is offered.
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="C4T Learning <learning@yourdomain.com>"

# ---------------------------------------------------------------- OPTIONAL --

# Used on certificates and verification links. Defaults to NEXTAUTH_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Existing website (the marketing pages and Notion course library) --------
# The learning platform does NOT need these. Without them the Notion course
# library is skipped and `next build` will fail on /courses/[...slug] only.
CONTENTFUL_SPACE_ID=""
CONTENTFUL_ACCESS_TOKEN=""
CONTENTFUL_PREVIEW_ACCESS_TOKEN=""
NOTION_API_KEY=""
C4T_FORCE_REVALIDATE_TOKEN=""
REDIS_URL=""
